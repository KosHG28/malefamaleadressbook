<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:backupAgent=".backup.CalendarBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher_wine"
        android:roundIcon="@mipmap/ic_launcher_wine"
        android:label="@string/app_name"
        android:theme="@style/Theme.CalendarApp"
        android:supportsRtl="true">
        <!-- Not itself a launcher entry point: exposed only through the palette-matched
             activity-aliases below, exactly one of which is enabled at a time (see
             CyclePreferences.syncLauncherIcon), so the home-screen icon follows the chosen
             color scheme from Settings. Since a launched task's root component is the alias,
             not this activity, that switch only ever happens with the app off screen: see
             MainActivity.onStop. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.App.Starting" />

        <!-- Handles the "Отметить начало" action button on the period-approaching reminder
             notification. Not exported: only reached via a PendingIntent this app builds itself. -->
        <receiver
            android:name=".reminders.MarkPeriodStartReceiver"
            android:exported="false" />

        <activity-alias
            android:name=".LauncherWine"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wine"
            android:roundIcon="@mipmap/ic_launcher_wine"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMidnight"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherForest"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest"
            android:roundIcon="@mipmap/ic_launcher_forest"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPlum"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_plum"
            android:roundIcon="@mipmap/ic_launcher_plum"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherGraphite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
